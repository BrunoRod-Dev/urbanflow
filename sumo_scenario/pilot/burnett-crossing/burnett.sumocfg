<configuration>
    <input>
        <net-file value="network.net.xml"/>
        <route-files value="routes.rou.xml,probe.rou.xml,pedestrians.rou.xml"/>
        <gui-settings-file value="gui.settings.xml"/>
    </input>
    <time>
        <end value="300"/>
        <step-length value="0.5"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <random_number>
        <seed value="42"/>
    </random_number>
</configuration>
